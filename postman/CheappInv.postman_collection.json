{
  "info": {
    "_postman_id": "8b5f6a90-0a0a-4cdd-bb3b-0a5b4c7f2a10",
    "name": "cheappInv - Inventory Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Colección para probar el microservicio cheappInv (inventario). Generada a partir de openapi.yaml.\n\nVariables de colección:\n- baseUrl (default: http://localhost:9090)\n- sku\n- warehouseId\n- correlationId\n- reason\n- eventId\n- quantity\n"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:9090" },
    { "key": "sku", "value": "SKU-1" },
    { "key": "warehouseId", "value": "MAIN" },
    { "key": "correlationId", "value": "corr-1" },
    { "key": "reason", "value": "Prueba desde Postman" },
    { "key": "eventId", "value": "evt-123" },
    { "key": "quantity", "value": "2" }
  ],
  "item": [
    {
      "name": "Inventory",
      "item": [
        {
          "name": "Get product (GET /api/products/{sku})",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/{{sku}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "{{sku}}"]
            }
          }
        },
        {
          "name": "Get stock (GET /api/stock)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/stock?sku={{sku}}&warehouseId={{warehouseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stock"],
              "query": [
                { "key": "sku", "value": "{{sku}}" },
                { "key": "warehouseId", "value": "{{warehouseId}}" }
              ]
            }
          }
        },
        {
          "name": "Block product (POST /api/products/{sku}/block)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/{{sku}}/block?correlationId={{correlationId}}&reason={{reason}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "{{sku}}", "block"],
              "query": [
                { "key": "correlationId", "value": "{{correlationId}}" },
                { "key": "reason", "value": "{{reason}}" }
              ]
            }
          }
        },
        {
          "name": "Reactivate product (POST /api/products/{sku}/reactivate)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/{{sku}}/reactivate?correlationId={{correlationId}}&reason={{reason}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "{{sku}}", "reactivate"],
              "query": [
                { "key": "correlationId", "value": "{{correlationId}}" },
                { "key": "reason", "value": "{{reason}}" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Events (in) - simulación",
      "item": [
        {
          "name": "Item agregado (POST /api/events/in/item-agregado)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"correlationId\": \"{{correlationId}}\",\n  \"sku\": \"{{sku}}\",\n  \"quantity\": {{quantity}},\n  \"warehouseId\": \"{{warehouseId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/events/in/item-agregado",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events", "in", "item-agregado"]
            }
          }
        },
        {
          "name": "Pedido proveedor recibido (POST /api/events/in/pedido-proveedor-recibido)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"correlationId\": \"{{correlationId}}\",\n  \"sku\": \"{{sku}}\",\n  \"quantity\": {{quantity}},\n  \"warehouseId\": \"{{warehouseId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/events/in/pedido-proveedor-recibido",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events", "in", "pedido-proveedor-recibido"]
            }
          }
        }
      ]
    }
  ]
}
